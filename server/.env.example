# ---- Server Environment Variables ----

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/ablespace

# JWT secret for signing tokens (use a strong random string in production)
JWT_SECRET=your-jwt-secret-change-me

# JWT token expiration (e.g., "7d" for 7 days, "1h" for 1 hour)
JWT_EXPIRES_IN=7d

# Server port
PORT=4000

# Frontend URL (for CORS — set to your Vercel deployment URL in production)
FRONTEND_URL=http://localhost:3000
